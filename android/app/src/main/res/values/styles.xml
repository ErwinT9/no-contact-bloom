<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Real app theme. This is what MainActivity runs under once the splash
      screen is dismissed (see postSplashScreenTheme below).

      Edge-to-edge notes:
      * No android:statusBarColor / android:navigationBarColor here — those are
        deprecated on API 35+ and are what Play flags. The system bars stay
        transparent because the window is laid out edge-to-edge from
        MainActivity via WindowCompat.setDecorFitsSystemWindows(window, false).
      * windowLightStatusBar/windowLightNavigationBar give correct icon
        contrast at cold start, before JS boots. values-night/ flips them.
        Once the web layer is up, SystemBars.setAppearance() keeps them in sync
        with the in-app light/dark preference (which is independent of the OS).
      * windowBackground is a DayNight colour so no white surface can ever be
        exposed behind the WebView in dark mode.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appWindowBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
      Launch (splash) theme, cold start only.

      The old @drawable/splash (white canvas + legacy leaf-heart logo) is gone:
      as `android:background` it became the *window* background and therefore
      re-appeared whenever the window repainted ahead of the WebView — most
      visibly when resuming the app from recents. The cold-start splash now
      uses the DayNight window colour plus the launcher icon, so there is no
      stale bitmap attached to the window and nothing to flash on resume.

      postSplashScreenTheme swaps the activity to AppTheme.NoActionBar as soon
      as the splash is dismissed (MainActivity also sets it defensively).
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/appWindowBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@color/appWindowBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
